<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane
    prefHeight="400.0"
    prefWidth="600.0"
    style="-fx-background-color: radial-gradient(center 50% 50%, radius 90%, #07462c, #021f13);"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example._0zo.controller.MenuController">

    <!-- Title -->
    <Label
        layoutX="170.0" layoutY="28.0"
        prefWidth="260.0"
        text="♠ CINCUENTAZO ♥"
        style="-fx-text-fill: #fbbf24; -fx-font-size: 28px; -fx-font-weight: bold; -fx-alignment: CENTER;"
        fx:id="titleLabel"/>

    <!-- Subtitle -->
    <Label
        layoutX="150.0" layoutY="70.0"
        prefWidth="300.0"
        text="No dejes que la suma supere los 50"
        style="-fx-text-fill: #86efac; -fx-font-size: 12px; -fx-alignment: CENTER;"/>

    <!-- Rules box -->
    <VBox
        layoutX="60.0" layoutY="100.0"
        prefWidth="480.0"
        spacing="4"
        style="-fx-background-color: rgba(0,0,0,0.35); -fx-background-radius: 8; -fx-border-color: #fbbf2466; -fx-border-radius: 8; -fx-padding: 12;">

        <Label text="Reglas del juego"
               style="-fx-text-fill: #fbbf24; -fx-font-weight: bold; -fx-font-size: 13px;"/>
        <Label text="• 2–8 y 10: suman su valor numérico."
               style="-fx-text-fill: #d1fae5;"/>
        <Label text="• J, Q, K: restan 10 a la suma."
               style="-fx-text-fill: #d1fae5;"/>
        <Label text="• 9: ni suma ni resta (neutro)."
               style="-fx-text-fill: #d1fae5;"/>
        <Label text="• A: suma 1 o 10, lo que más convenga."
               style="-fx-text-fill: #d1fae5;"/>
        <Label text="• Cada jugador mantiene 4 cartas. Quien no pueda jugar sin pasar de 50 queda eliminado."
               style="-fx-text-fill: #86efac; -fx-font-size: 11px;" wrapText="true"/>
    </VBox>

    <!-- Player selector -->
    <VBox
        layoutX="175.0" layoutY="240.0"
        prefWidth="250.0"
        alignment="CENTER"
        spacing="12"
        style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 10; -fx-border-color: #fbbf24; -fx-border-radius: 10; -fx-padding: 18;">

        <Label
            text="¿Cuántos jugadores CPU?"
            style="-fx-text-fill: #fbbf24; -fx-font-weight: bold; -fx-font-size: 13px;"/>

        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="btn1" text="1"
                    prefWidth="56" prefHeight="46"
                    onAction="#onBtn1Clicked"
                    style="-fx-background-color: #032415; -fx-text-fill: #fbbf24; -fx-border-color: #fbbf24; -fx-border-radius: 6; -fx-font-size: 20px; -fx-cursor: hand;"/>
            <Button fx:id="btn2" text="2"
                    prefWidth="56" prefHeight="46"
                    onAction="#onBtn2Clicked"
                    style="-fx-background-color: #032415; -fx-text-fill: #fbbf24; -fx-border-color: #fbbf24; -fx-border-radius: 6; -fx-font-size: 20px; -fx-cursor: hand;"/>
            <Button fx:id="btn3" text="3"
                    prefWidth="56" prefHeight="46"
                    onAction="#onBtn3Clicked"
                    style="-fx-background-color: #032415; -fx-text-fill: #fbbf24; -fx-border-color: #fbbf24; -fx-border-radius: 6; -fx-font-size: 20px; -fx-cursor: hand;"/>
        </HBox>

        <Button fx:id="btnPlay" text="▶  JUGAR"
                prefWidth="160" prefHeight="46"
                onAction="#onPlayClicked"
                style="-fx-background-color: #fbbf24; -fx-text-fill: #021f13; -fx-font-weight: bold; -fx-font-size: 18px; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </VBox>

</AnchorPane>
