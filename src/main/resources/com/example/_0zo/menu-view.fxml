<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="459.0" prefWidth="600.0" style="-fx-background-color: radial-gradient(center 50% 50%, radius 90%, #07462c, #021f13);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example._0zo.controller.MenuController">

    <!-- Title -->
    <Label fx:id="titleLabel" layoutX="170.0" layoutY="28.0" prefWidth="260.0" style="-fx-text-fill: #fbbf24; -fx-font-size: 28px; -fx-font-weight: bold; -fx-alignment: CENTER;" text="♠ CINCUENTAZO ♥" />

    <!-- Subtitle -->
    <Label layoutX="150.0" layoutY="70.0" prefWidth="300.0" style="-fx-text-fill: #86efac; -fx-font-size: 12px; -fx-alignment: CENTER;" text="No dejes que la suma supere los 50" />

    <!-- Rules box -->
    <VBox layoutX="60.0" layoutY="100.0" prefWidth="480.0" spacing="4" style="-fx-background-color: rgba(0,0,0,0.35); -fx-background-radius: 8; -fx-border-color: #fbbf2466; -fx-border-radius: 8; -fx-padding: 12;">

        <Label style="-fx-text-fill: #fbbf24; -fx-font-weight: bold; -fx-font-size: 13px;" text="Reglas del juego" />
        <Label style="-fx-text-fill: #d1fae5;" text="• 2–8 y 10: suman su valor numérico." />
        <Label style="-fx-text-fill: #d1fae5;" text="• J, Q, K: restan 10 a la suma." />
        <Label style="-fx-text-fill: #d1fae5;" text="• 9: ni suma ni resta (neutro)." />
        <Label style="-fx-text-fill: #d1fae5;" text="• A: suma 1 o 10, lo que más convenga." />
        <Label style="-fx-text-fill: #86efac; -fx-font-size: 11px;" text="• Cada jugador mantiene 4 cartas. Quien no pueda jugar sin pasar de 50 queda eliminado." wrapText="true" />
    </VBox>

    <!-- Player selector -->
    <VBox alignment="CENTER" layoutX="175.0" layoutY="261.0" prefWidth="250.0" spacing="12" style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 10; -fx-border-color: #fbbf24; -fx-border-radius: 10; -fx-padding: 18;">

        <Label style="-fx-text-fill: #fbbf24; -fx-font-weight: bold; -fx-font-size: 13px;" text="¿Cuántos jugadores CPU?" />

        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="btn1" onAction="#onBtn1Clicked" prefHeight="46" prefWidth="56" style="-fx-background-color: #032415; -fx-text-fill: #fbbf24; -fx-border-color: #fbbf24; -fx-border-radius: 6; -fx-font-size: 20px; -fx-cursor: hand;" text="1" />
            <Button fx:id="btn2" onAction="#onBtn2Clicked" prefHeight="46" prefWidth="56" style="-fx-background-color: #032415; -fx-text-fill: #fbbf24; -fx-border-color: #fbbf24; -fx-border-radius: 6; -fx-font-size: 20px; -fx-cursor: hand;" text="2" />
            <Button fx:id="btn3" onAction="#onBtn3Clicked" prefHeight="46" prefWidth="56" style="-fx-background-color: #032415; -fx-text-fill: #fbbf24; -fx-border-color: #fbbf24; -fx-border-radius: 6; -fx-font-size: 20px; -fx-cursor: hand;" text="3" />
        </HBox>

        <Button fx:id="btnPlay" onAction="#onPlayClicked" prefHeight="46" prefWidth="160" style="-fx-background-color: #fbbf24; -fx-text-fill: #021f13; -fx-font-weight: bold; -fx-font-size: 18px; -fx-background-radius: 8; -fx-cursor: hand;" text="▶  JUGAR" />
    </VBox>

</AnchorPane>
