<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      prefHeight="560"
      prefWidth="480"
      spacing="24"
      styleClass="root-end"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example._0zo.controller.EndController">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- Result icon -->
    <Label fx:id="resultIcon"
           styleClass="result-icon"
           text=""/>

    <!-- Result subtitle -->
    <Label fx:id="resultSubtitle"
           styleClass="result-subtitle"
           text="¡Ganador de la partida!"/>

    <!-- Winner name -->
    <Label fx:id="winnerName"
           styleClass="winner-name"
           text="Jugador 1"/>

    <!-- Stats -->
    <HBox alignment="CENTER" spacing="12">

        <VBox alignment="CENTER"
              prefWidth="100"
              spacing="4"
              styleClass="stat-cell">
            <Label fx:id="statRoundsValue"
                   styleClass="stat-value"
                   text="12"/>
            <Label styleClass="stat-label"
                   text="Rondas"/>
        </VBox>

        <VBox alignment="CENTER"
              prefWidth="100"
              spacing="4"
              styleClass="stat-cell">
            <Label fx:id="statCardsValue"
                   styleClass="stat-value"
                   text="47"/>
            <Label styleClass="stat-label"
                   text="Cartas jugadas"/>
        </VBox>

        <VBox alignment="CENTER"
              prefWidth="100"
              spacing="4"
              styleClass="stat-cell">
            <Label fx:id="statMaxSumValue"
                   styleClass="stat-value"
                   text="49"/>
            <Label styleClass="stat-label"
                   text="Suma máx."/>
        </VBox>

    </HBox>

    <!-- Buttons -->
    <VBox fillWidth="true"
          maxWidth="320"
          spacing="10">

        <Button fx:id="btnRematch"
                text="Revancha"
                prefHeight="44"
                maxWidth="Infinity"
                styleClass="btn-primary"
                onAction="#onRematchClicked"/>

        <Button fx:id="btnMenu"
                text="Volver al menú"
                prefHeight="36"
                maxWidth="Infinity"
                styleClass="btn-secondary"
                onAction="#onMenuClicked"/>

    </VBox>

</VBox>