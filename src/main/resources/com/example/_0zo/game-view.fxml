<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="620"
            prefWidth="800"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example._0zo.controller.GameController">

   <!-- ================= TOP ================= -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="16"
            style="-fx-background-color: linear-gradient(to right, #07462c, #021f13); -fx-padding: 10;">

         <Label fx:id="deckInfoLabel"
                text="👑 Mazo: 48 cartas"
                style="-fx-text-fill: #fbbf24; -fx-font-weight: bold;"/>

         <Region HBox.hgrow="ALWAYS"/>

         <Label fx:id="sumBadge"
                text="0"
                style="-fx-text-fill: #fbbf24; -fx-font-size: 20px; -fx-font-weight: bold;"/>

         <Region HBox.hgrow="ALWAYS"/>

         <Label fx:id="turnLabel"
                text="Turno: Jugador 1"
                style="-fx-text-fill: white; -fx-font-weight: bold;"/>

      </HBox>
   </top>

   <!-- ================= CENTER ================= -->
   <center>
      <VBox spacing="14"
            style="-fx-background-color: radial-gradient(center 50% 50%, radius 85%, #07462c, #021f13); -fx-padding: 16;">

         <!-- OPONENTES -->
         <HBox fx:id="opponentsRow" alignment="CENTER" spacing="20">

            <!-- CPU 1 -->
            <VBox alignment="CENTER" spacing="4">
               <Label fx:id="opp1Name" text="👑 MÁQUINA 1"
                      style="-fx-text-fill: #fbbf24;"/>
               <HBox fx:id="opp1Cards" spacing="3">
                  <StackPane prefWidth="50" prefHeight="70" style="-fx-background-color:#111;-fx-border-color:#fbbf24;"/>
                  <StackPane prefWidth="50" prefHeight="70" style="-fx-background-color:#111;-fx-border-color:#fbbf24;"/>
                  <StackPane prefWidth="50" prefHeight="70" style="-fx-background-color:#111;-fx-border-color:#fbbf24;"/>
               </HBox>
            </VBox>

            <!-- CPU 2 -->
            <VBox alignment="CENTER" spacing="4">
               <Label fx:id="opp2Name" text="👑 MÁQUINA 2"
                      style="-fx-text-fill: #fbbf24;"/>
               <HBox fx:id="opp2Cards" spacing="3">
                  <StackPane prefWidth="50" prefHeight="70" style="-fx-background-color:#111;-fx-border-color:#fbbf24;"/>
                  <StackPane prefWidth="50" prefHeight="70" style="-fx-background-color:#111;-fx-border-color:#fbbf24;"/>
                  <StackPane prefWidth="50" prefHeight="70" style="-fx-background-color:#111;-fx-border-color:#fbbf24;"/>
               </HBox>
            </VBox>

            <!-- CPU 3 -->
            <VBox alignment="CENTER" spacing="4">
               <Label fx:id="opp3Name" text="👑 MÁQUINA 3"
                      style="-fx-text-fill: #fbbf24;"/>
               <HBox fx:id="opp3Cards" spacing="3">
                  <StackPane prefWidth="50" prefHeight="70" style="-fx-background-color:#111;-fx-border-color:#fbbf24;"/>
                  <StackPane prefWidth="50" prefHeight="70" style="-fx-background-color:#111;-fx-border-color:#fbbf24;"/>
                  <StackPane prefWidth="50" prefHeight="70" style="-fx-background-color:#111;-fx-border-color:#fbbf24;"/>
               </HBox>
            </VBox>

         </HBox>

         <!-- ================= TABLE ================= -->
         <HBox alignment="CENTER" spacing="40">

            <!-- DECK -->
            <VBox alignment="CENTER" spacing="5">
               <Label text="Mazo" style="-fx-text-fill: white;"/>

               <StackPane fx:id="paneDeck"
                          prefWidth="90"
                          prefHeight="130"
                          onMouseClicked="#onDeckClicked"
                          style="-fx-background-color: linear-gradient(to bottom right, #b45309, #d97706);
                                      -fx-background-radius: 8;
                                      -fx-border-color: #fbbf24;
                                      -fx-cursor: hand;">
                  <Circle radius="20" stroke="#fbbf24" fill="transparent"/>
               </StackPane>

               <Label fx:id="deckPileCount"
                      text="48"
                      style="-fx-text-fill: #fbbf24;"/>
            </VBox>

            <!-- TABLE CARD -->
            <VBox alignment="CENTER" spacing="6">

               <Label text="Mesa"
                      style="-fx-text-fill: white;"/>

               <StackPane fx:id="tableCardPane"
                          prefWidth="90"
                          prefHeight="130"
                          style="-fx-background-color: #f5f5dc;
                                      -fx-background-radius: 8;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 10, 0, 3, 5);">

                  <VBox alignment="CENTER">
                     <Label fx:id="tableCardRank" text="A"/>
                     <Label fx:id="tableCardSuit" text="♠"/>
                     <Label fx:id="tableCardHint" text="+1"/>
                  </VBox>

               </StackPane>

            </VBox>

            <!-- SUM -->
            <VBox alignment="CENTER" spacing="6">
               <Label text="Suma" style="-fx-text-fill: white;"/>
               <Label fx:id="lastValueBadge"
                      text="0"
                      style="-fx-text-fill: #fbbf24; -fx-font-size: 24px;"/>
            </VBox>

         </HBox>

         <!-- LOG -->
         <TextArea fx:id="logArea"
                   prefHeight="80"
                   editable="false"
                   wrapText="true"
                   style="-fx-background-color: #021f13; -fx-text-fill: #fbbf24;"/>

      </VBox>
   </center>

   <!-- ================= BOTTOM ================= -->
   <bottom>
      <VBox spacing="10"
            style="-fx-background-color: #021f13; -fx-padding: 10;">

         <Label text="👤 TU MANO"
                style="-fx-text-fill: #fbbf24; -fx-font-weight: bold;"/>

         <HBox fx:id="humanHandBox"
               alignment="CENTER"
               spacing="12">

            <!-- dinámico desde controller -->

         </HBox>

         <HBox alignment="CENTER" spacing="20">

            <Button text="REGLAS"
                    onAction="#onHandleHelp"
                    style="-fx-background-color:#032415;-fx-text-fill:#fbbf24;"/>

            <Button text="↩"
                    onAction="#onHandleUndo"
                    style="-fx-background-color:#991b1b;-fx-text-fill:white;"/>

         </HBox>

      </VBox>
   </bottom>

</BorderPane>