<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="620" prefWidth="800" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example._0zo.controller.GameController">

    <!-- ======= TOP BAR ======= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: linear-gradient(to right, #07462c, #021f13); -fx-padding: 10;">
            <Label fx:id="deckInfoLabel" style="-fx-text-fill: #fbbf24; -fx-font-weight: bold;" text="👑 Mazo: 48 cartas" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="sumBadge" style="-fx-text-fill: #4ade80; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="turnLabel" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Turno: Tú" />
        </HBox>
    </top>

    <!-- ======= CENTER ======= -->
    <center>
        <VBox spacing="14" style="-fx-background-color: radial-gradient(center 50% 50%, radius 85%, #07462c, #021f13);" xmlns:fx="http://javafx.com/fxml/1">
            <padding><Insets bottom="8" left="16" right="16" top="14" /></padding>

            <!-- OPPONENTS ROW -->
            <HBox fx:id="opponentsRow" alignment="CENTER" spacing="40">

                <!-- CPU 1 -->
                <VBox alignment="CENTER" spacing="6">
                    <Label fx:id="opp1Name" style="-fx-text-fill: #fbbf24; -fx-font-weight: bold;" text="🤖 CPU 1" />
                    <HBox fx:id="opp1Cards" alignment="CENTER" spacing="4" />
                </VBox>

                <!-- CPU 2 -->
                <VBox alignment="CENTER" spacing="6">
                    <Label fx:id="opp2Name" style="-fx-text-fill: #fbbf24; -fx-font-weight: bold;" text="🤖 CPU 2" />
                    <HBox fx:id="opp2Cards" alignment="CENTER" spacing="4" />
                </VBox>

                <!-- CPU 3 -->
                <VBox alignment="CENTER" spacing="6">
                    <Label fx:id="opp3Name" style="-fx-text-fill: #fbbf24; -fx-font-weight: bold;" text="🤖 CPU 3" />
                    <HBox fx:id="opp3Cards" alignment="CENTER" spacing="4" />
                </VBox>

            </HBox>

            <!-- TABLE AREA: Deck | Table Card | Sum -->
            <HBox alignment="CENTER" spacing="40">

                <!-- DECK PILE -->
                <VBox alignment="CENTER" spacing="6">
                    <Label style="-fx-text-fill: #d1fae5; -fx-font-size: 12px;" text="Mazo" />
                    <StackPane fx:id="paneDeck" onMouseClicked="#onDeckClicked" prefHeight="130" prefWidth="90" style="-fx-background-color: linear-gradient(to bottom right, #b45309, #d97706);                                       -fx-background-radius: 8;                                       -fx-border-color: #fbbf24;                                       -fx-border-radius: 8;                                       -fx-cursor: hand;">
                        <Circle fill="transparent" radius="20" stroke="#fbbf24" />
                    </StackPane>
                    <Label fx:id="deckPileCount" style="-fx-text-fill: #fbbf24; -fx-font-weight: bold;" text="48" />
                </VBox>

                <!-- TABLE CARD -->
                <VBox alignment="CENTER" spacing="6">
                    <Label style="-fx-text-fill: #d1fae5; -fx-font-size: 12px;" text="Mesa" />
                    <StackPane fx:id="tableCardPane" prefHeight="130" prefWidth="90" style="-fx-background-color: #f5f5dc;                                       -fx-background-radius: 8;                                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 10, 0, 3, 5);">
                        <VBox alignment="CENTER">
                            <Label fx:id="tableCardRank" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="—" />
                            <Label fx:id="tableCardSuit" style="-fx-font-size: 18px;" text="" />
                            <Label fx:id="tableCardHint" style="-fx-font-size: 11px; -fx-text-fill: #555;" text="" />
                        </VBox>
                    </StackPane>
                </VBox>

                <!-- CURRENT SUM -->
                <VBox alignment="CENTER" spacing="6">
                    <Label style="-fx-text-fill: #d1fae5; -fx-font-size: 12px;" text="Suma" />
                    <Label fx:id="lastValueBadge" style="-fx-text-fill: #4ade80; -fx-font-size: 36px; -fx-font-weight: bold;" text="0" />
                </VBox>

            </HBox>

            <!-- LOG -->
            <TextArea fx:id="logArea" editable="false" prefHeight="80" style="-fx-background-color: #021f13; -fx-text-fill: black; -fx-font-size: 12px; -fx-border-color: #fbbf2444;" wrapText="true" />

        </VBox>
    </center>

    <!-- ======= BOTTOM: HUMAN HAND ======= -->
    <bottom>
        <VBox spacing="10" style="-fx-background-color: #021f13; -fx-padding: 12;">

            <Label style="-fx-text-fill: #fbbf24; -fx-font-weight: bold; -fx-font-size: 13px;" text="👤 TU MANO" />

            <HBox fx:id="humanHandBox" alignment="CENTER" spacing="14" style="-fx-padding: 6;" />

            <HBox alignment="CENTER" spacing="20">
                <Button onAction="#onHandleHelp" style="-fx-background-color: #032415; -fx-text-fill: #fbbf24;                                -fx-border-color: #fbbf24; -fx-border-radius: 6;                                -fx-cursor: hand;" text="📋 REGLAS" />
                <Button onAction="#onHandleUndo" style="-fx-background-color: #7f1d1d; -fx-text-fill: white;                                -fx-border-radius: 6; -fx-cursor: hand;" text="↩ DESHACER" />
            </HBox>

        </VBox>
    </bottom>

</BorderPane>
