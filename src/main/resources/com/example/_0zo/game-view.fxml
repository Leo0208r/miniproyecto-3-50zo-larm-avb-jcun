<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="620" prefWidth="800"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example._0zo.controller.GameController">

    <!-- ======= TOP BAR ======= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: linear-gradient(to right, #07462c, #021f13); -fx-padding: 10;">
            <Label fx:id="deckInfoLabel" text="👑 Mazo: 48 cartas"
                   style="-fx-text-fill: #fbbf24; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="sumBadge" text="0"
                   style="-fx-text-fill: #4ade80; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="turnLabel" text="Turno: Tú"
                   style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- ======= CENTER ======= -->
    <center>
        <VBox spacing="14"
              style="-fx-background-color: radial-gradient(center 50% 50%, radius 85%, #07462c, #021f13);"
              xmlns:fx="http://javafx.com/fxml/1">
            <padding><Insets top="14" right="16" bottom="8" left="16"/></padding>

            <!-- OPPONENTS ROW -->
            <HBox fx:id="opponentsRow" alignment="CENTER" spacing="40">

                <!-- CPU 1 -->
                <VBox alignment="CENTER" spacing="6">
                    <Label fx:id="opp1Name" text="🤖 CPU 1"
                           style="-fx-text-fill: #fbbf24; -fx-font-weight: bold;"/>
                    <HBox fx:id="opp1Cards" alignment="CENTER" spacing="4"/>
                </VBox>

                <!-- CPU 2 -->
                <VBox alignment="CENTER" spacing="6">
                    <Label fx:id="opp2Name" text="🤖 CPU 2"
                           style="-fx-text-fill: #fbbf24; -fx-font-weight: bold;"/>
                    <HBox fx:id="opp2Cards" alignment="CENTER" spacing="4"/>
                </VBox>

                <!-- CPU 3 -->
                <VBox alignment="CENTER" spacing="6">
                    <Label fx:id="opp3Name" text="🤖 CPU 3"
                           style="-fx-text-fill: #fbbf24; -fx-font-weight: bold;"/>
                    <HBox fx:id="opp3Cards" alignment="CENTER" spacing="4"/>
                </VBox>

            </HBox>

            <!-- TABLE AREA: Deck | Table Card | Sum -->
            <HBox alignment="CENTER" spacing="40">

                <!-- DECK PILE -->
                <VBox alignment="CENTER" spacing="6">
                    <Label text="Mazo" style="-fx-text-fill: #d1fae5; -fx-font-size: 12px;"/>
                    <StackPane fx:id="paneDeck"
                               prefWidth="90" prefHeight="130"
                               onMouseClicked="#onDeckClicked"
                               style="-fx-background-color: linear-gradient(to bottom right, #b45309, #d97706);
                                      -fx-background-radius: 8;
                                      -fx-border-color: #fbbf24;
                                      -fx-border-radius: 8;
                                      -fx-cursor: hand;">
                        <Circle radius="20" stroke="#fbbf24" fill="transparent"/>
                    </StackPane>
                    <Label fx:id="deckPileCount" text="48"
                           style="-fx-text-fill: #fbbf24; -fx-font-weight: bold;"/>
                </VBox>

                <!-- TABLE CARD -->
                <VBox alignment="CENTER" spacing="6">
                    <Label text="Mesa" style="-fx-text-fill: #d1fae5; -fx-font-size: 12px;"/>
                    <StackPane fx:id="tableCardPane"
                               prefWidth="90" prefHeight="130"
                               style="-fx-background-color: #f5f5dc;
                                      -fx-background-radius: 8;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 10, 0, 3, 5);">
                        <VBox alignment="CENTER">
                            <Label fx:id="tableCardRank" text="—"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                            <Label fx:id="tableCardSuit" text=""
                                   style="-fx-font-size: 18px;"/>
                            <Label fx:id="tableCardHint" text=""
                                   style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                        </VBox>
                    </StackPane>
                </VBox>

                <!-- CURRENT SUM -->
                <VBox alignment="CENTER" spacing="6">
                    <Label text="Suma" style="-fx-text-fill: #d1fae5; -fx-font-size: 12px;"/>
                    <Label fx:id="lastValueBadge" text="0"
                           style="-fx-text-fill: #4ade80; -fx-font-size: 36px; -fx-font-weight: bold;"/>
                </VBox>

            </HBox>

            <!-- LOG -->
            <TextArea fx:id="logArea"
                      prefHeight="80"
                      editable="false"
                      wrapText="true"
                      style="-fx-background-color: #021f13; -fx-text-fill: #86efac;
                             -fx-font-size: 12px; -fx-border-color: #fbbf2444;"/>

        </VBox>
    </center>

    <!-- ======= BOTTOM: HUMAN HAND ======= -->
    <bottom>
        <VBox spacing="10"
              style="-fx-background-color: #021f13; -fx-padding: 12;">

            <Label text="👤 TU MANO"
                   style="-fx-text-fill: #fbbf24; -fx-font-weight: bold; -fx-font-size: 13px;"/>

            <HBox fx:id="humanHandBox"
                  alignment="CENTER"
                  spacing="14"
                  style="-fx-padding: 6;"/>

            <HBox alignment="CENTER" spacing="20">
                <Button text="📋 REGLAS"
                        onAction="#onHandleHelp"
                        style="-fx-background-color: #032415; -fx-text-fill: #fbbf24;
                               -fx-border-color: #fbbf24; -fx-border-radius: 6;
                               -fx-cursor: hand;"/>
                <Button text="↩ DESHACER"
                        onAction="#onHandleUndo"
                        style="-fx-background-color: #7f1d1d; -fx-text-fill: white;
                               -fx-border-radius: 6; -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </bottom>

</BorderPane>
